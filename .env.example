DATABASE_URL=postgresql://username:password@localhost:5432/agos_db

SECRET_KEY=your_secret_key_here
IOT_API_KEY=rpi_secret_key_here
ALGORITHM=HS256
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# STREAM_URL=rtsp://127.0.0.1:8554/agos_stream
STREAM_URL=https://cdn-002.whatsupcams.com/hls/hr_nov2.m3u8

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

GROQ_API_KEYS=api_key_1,api_key_2,api_key_3

VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_CLAIM_EMAIL=mailto:your-email@example.com

# SMS Gateway (Android phone running SMS Gateway API app)
SMS_GATEWAY_URL=http://192.168.1.100:8080
SMS_GATEWAY_API_KEY=your_gateway_api_key_here

# F2 — Weather provider abstraction (sub-hourly refresh)
# WEATHER_PROVIDER: openweathermap | weatherapi | openmeteo (default: openmeteo)
WEATHER_PROVIDER=openmeteo
OPENWEATHERMAP_API_KEY=
WEATHERAPI_API_KEY=
WEATHER_FETCH_INTERVAL_MINUTES=10

# F1 — Surface-obstruction confidence engine
OBSTRUCTION_WINDOW_K=5
OBSTRUCTION_TIER_LIKELY=0.6
OBSTRUCTION_TIER_CONFIRMED=0.8
OBSTRUCTION_PARTIAL_WEIGHT=0.5
FRAME_CAPTURE_INTERVAL_ELEVATED_SECONDS=30

# F4 — Public evacuation workflow
EVACUATION_RECOMMEND_MIN_SCORE=70
EVACUATION_RECOMMEND_COOLDOWN_SECONDS=900